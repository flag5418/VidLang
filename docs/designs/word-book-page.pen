{
  "version": "2.11",
  "name": "VidLang Word Book Page - 生词本页面设计",
  "description": "生词本/收藏页面，包含单词列表、搜索、筛选功能",
  "basedOn": "Pencil UI Design Skill v2.0",
  "created": "2026-06-27",
  
  "children": [
    {
      "id": "wordBookPage",
      "type": "frame",
      "name": "WordBookPage - 生词本页面",
      "width": 390,
      "height": 844,
      "fill": "#FAFAFA", // backgroundLight
      "cornerRadius": 0,
      "layout": "vertical",
      "padding": [16, 16, 0, 16],
      "children": [
        // 导航栏
        {
          "id": "navBar",
          "type": "frame",
          "name": "导航栏",
          "width": "fill_container",
          "layout": "horizontal",
          "alignItems": "center",
          "justifyContent": "space_between",
          "children": [
            {
              "id": "title",
              "type": "text",
              "name": "生词本",
              "content": "生词本",
              "fontSize": 20,
              "fontWeight": 600,
              "fill": "#18181B",
              "textGrowth": "auto"
            },
            {
              "id": "statsBadge",
              "type": "frame",
              "name": "统计徽章",
              "height": 24,
              "padding": [6, 12, 6, 12],
              "fill": "#DCFCE7", // primaryBrandLight
              "cornerRadius": 9999, // 胶囊形状
              "layout": "horizontal",
              "alignItems": "center",
              "children": [
                {
                  "id": "statsText",
                  "type": "text",
                  "name": "128 个单词",
                  "content": "128 个单词",
                  "fontSize": 12,
                  "fontWeight": 500,
                  "fill": "#22C55E", // success / primaryBrandDark
                  "textGrowth": "auto"
                }
              ]
            }
          ]
        },
        
        // 搜索和筛选栏
        {
          "id": "searchFilterBar",
          "type": "frame",
          "name": "搜索筛选栏",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            // 搜索框
            {
              "id": "searchInput",
              "type": "frame",
              "name": "搜索框",
              "width": "fill_container",
              "height": 44,
              "fill": "#FFFFFF",
              "cornerRadius": 8,
              "layout": "horizontal",
              "alignItems": "center",
              "padding": [0, 12, 0, 12],
              "gap": 8,
              "border": {
                "all": {"color": "#E4E4E7", "width": 1}
              },
              "children": [
                {
                  "id": "searchIcon",
                  "type": "icon_font",
                  "iconFontFamily": "Material Symbols Rounded",
                  "iconFontName": "search",
                  "fontSize": 20,
                  "width": 20,
                  "height": 20,
                  "fill": "#A1A1AA"
                },
                {
                  "id": "searchPlaceholder",
                  "type": "text",
                  "name": "搜索单词...",
                  "content": "搜索单词...",
                  "fontSize": 14,
                  "fontWeight": 400,
                  "fill": "#A1A1AA",
                  "textGrowth": "auto"
                }
              ]
            },
            
            // 筛选标签行
            {
              "id": "filterTags",
              "type": "frame",
              "name": "筛选标签",
              "width": "fill_container",
              "layout": "horizontal",
              "gap": 8,
              "children": [
                // 全部（选中状态）
                {
                  "id": "filterAll",
                  "type": "frame",
                  "name": "全部 (Active)",
                  "height": 32,
                  "padding": [8, 16, 8, 16],
                  "fill": "#18181B", // textPrimary (深色背景)
                  "cornerRadius": 9999,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "filterAllText",
                      "type": "text",
                      "name": "全部",
                      "content": "全部",
                      "fontSize": 13,
                      "fontWeight": 500,
                      "fill": "#FFFFFF",
                      "textGrowth": "auto"
                    }
                  ]
                },
                
                // 未掌握
                {
                  "id": "filterNew",
                  "type": "frame",
                  "name": "未掌握",
                  "height": 32,
                  "padding": [8, 16, 8, 16],
                  "fill": "#F4F4F5", // surfaceSecondaryLight
                  "cornerRadius": 9999,
                  "border": {
                    "all": {"color": "#E4E4E7", "width": 1}
                  },
                  "layout": "horizontal",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "filterNewText",
                      "type": "text",
                      "name": "未掌握",
                      "content": "未掌握",
                      "fontSize": 13,
                      "fontWeight": 400,
                      "fill": "#71717A",
                      "textGrowth": "auto"
                    }
                  ]
                },
                
                // 学习中
                {
                  "id": "filterLearning",
                  "type": "frame",
                  "name": "学习中",
                  "height": 32,
                  "padding": [8, 16, 8, 16],
                  "fill": "#F4F4F5",
                  "cornerRadius": 9999,
                  "border": {
                    "all": {"color": "#E4E4E7", "width": 1}
                  },
                  "layout": "horizontal",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "filterLearningText",
                      "type": "text",
                      "name": "学习中",
                      "content": "学习中",
                      "fontSize": 13,
                      "fontWeight": 400,
                      "fill": "#71717A",
                      "textGrowth": "auto"
                    }
                  ]
                },
                
                // 已掌握
                {
                  "id": "filterMastered",
                  "type": "frame",
                  "name": "已掌握",
                  "height": 32,
                  "padding": [8, 16, 8, 16],
                  "fill": "#F4F4F5",
                  "cornerRadius": 9999,
                  "border": {
                    "all": {"color": "#E4E4E7", "width": 1}
                  },
                  "layout": "horizontal",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "filterMasteredText",
                      "type": "text",
                      "name": "已掌握",
                      "content": "已掌握",
                      "fontSize": 13,
                      "fontWeight": 400,
                      "fill": "#71717A",
                      "textGrowth": "auto"
                    }
                  ]
                }
              ]
            }
          ]
        },
        
        // 单词列表
        {
          "id": "wordList",
          "type": "frame",
          "name": "单词列表",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "vertical",
          "gap": 8, // listItemSpacing
          "children": [
            // 单词卡片 1
            {
              "id": "wordCard1",
              "type": "frame",
              "name": "WordCard - extraordinary",
              "width": "fill_container",
              "fill": "#FFFFFF", // surfaceLight
              "cornerRadius": 12, // radius-lg
              "padding": [12, 12, 12, 12],
              "layout": "horizontal",
              "alignItems": "center",
              "gap": 12,
              "effect": {
                "type": "shadow",
                "shadowType": "outer",
                "color": "#0000000D",
                "blur": 4,
                "offsetY": 2
              },
              "border": {
                "all": {"color": "#E4E4E7", "width": 1}
              },
              "children": [
                // 单词信息
                {
                  "id": "wordInfo1",
                  "type": "frame",
                  "name": "单词信息",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "id": "wordText1",
                      "type": "text",
                      "name": "extraordinary",
                      "content": "extraordinary",
                      "fontSize": 16,
                      "fontWeight": 600,
                      "fill": "#18181B",
                      "textGrowth": "auto"
                    },
                    {
                      "id": "phonetic1",
                      "type": "text",
                      "name": "/ɪkˈstrɔːrdneri/",
                      "content": "/ɪkˈstrɔːrdneri/",
                      "fontSize": 12,
                      "fontWeight": 400,
                      "fill": "#71717A",
                      "fontFamily": "SF Mono",
                      "textGrowth": "auto"
                    },
                    {
                      "id": "translation1",
                      "type": "text",
                      "name": "adj. 非凡的；特大的",
                      "content": "adj. 非凡的；特大的",
                      "fontSize": 14,
                      "fontWeight": 400,
                      "fill": "#71717A",
                      "maxLines": 1,
                      "textGrowth": "truncate"
                    }
                  ]
                },
                
                // 操作按钮（播放发音）
                {
                  "id": "playAudioBtn1",
                  "type": "frame",
                  "name": "播放发音按钮",
                  "width": 40,
                  "height": 40,
                  "fill": "#F4F4F5",
                  "cornerRadius": 9999,
                  "layout": "vertical",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    {
                      "id": "volumeIcon1",
                      "type": "icon_font",
                      "iconFontFamily": "Material Symbols Rounded",
                      "iconFontName": "volume_up",
                      "fontSize": 22,
                      "width": 22,
                      "height": 22,
                      "fill": "#71717A"
                    }
                  ]
                }
              ]
            },
            
            // 单词卡片 2
            {
              "id": "wordCard2",
              "type": "frame",
              "name": "WordCard - ubiquitous",
              "width": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 12,
              "padding": [12, 12, 12, 12],
              "layout": "horizontal",
              "alignItems": "center",
              "gap": 12,
              "effect": {
                "type": "shadow",
                "shadowType": "outer",
                "color": "#0000000D",
                "blur": 4,
                "offsetY": 2
              },
              "border": {
                "all": {"color": "#E4E4E7", "width": 1}
              },
              "children": [
                {
                  "id": "wordInfo2",
                  "type": "frame",
                  "name": "单词信息",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "id": "wordText2",
                      "type": "text",
                      "name": "ubiquitous",
                      "content": "ubiquitous",
                      "fontSize": 16,
                      "fontWeight": 600,
                      "fill": "#18181B",
                      "textGrowth": "auto"
                    },
                    {
                      "id": "phonetic2",
                      "type": "text",
                      "name": "/juːˈbɪkwɪtəs/",
                      "content": "/juːˈbɪkwɪtəs/",
                      "fontSize": 12,
                      "fontWeight": 400,
                      "fill": "#71717A",
                      "fontFamily": "SF Mono",
                      "textGrowth": "auto"
                    },
                    {
                      "id": "translation2",
                      "type": "text",
                      "name": "adj. 无处不在的；普遍存在的",
                      "content": "adj. 无处不在的；普遍存在的",
                      "fontSize": 14,
                      "fontWeight": 400,
                      "fill": "#71717A",
                      "maxLines": 1,
                      "textGrowth": "truncate"
                    }
                  ]
                },
                {
                  "id": "playAudioBtn2",
                  "type": "frame",
                  "name": "播放发音按钮",
                  "width": 40,
                  "height": 40,
                  "fill": "#F4F4F5",
                  "cornerRadius": 9999,
                  "layout": "vertical",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    {
                      "id": "volumeIcon2",
                      "type": "icon_font",
                      "iconFontFamily": "Material Symbols Rounded",
                      "iconFontName": "volume_up",
                      "fontSize": 22,
                      "width": 22,
                      "height": 22,
                      "fill": "#71717A"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  
  "designNotes": [
    "基于 Pencil Skill 的工业级设计规范",
    "单词卡片使用水平布局：左侧信息 + 右侧操作按钮",
    "单词文本使用 16px + 600 字重，突出显示",
    "音标使用等宽字体 (SF Mono) + 灰色",
    "翻译文本限制单行显示，超出截断",
    "播放按钮为圆形 (radius-full)，次要背景色",
    "筛选标签使用胶囊形状 (radius-full)",
    "选中标签使用深色背景 (#18181B) + 白色文字",
    "统计徽章使用品牌色系 (primaryBrandLight/Dark)",
    "卡片间距 8px (listItemSpacing)"
  ],
  
  "components": [
    {
      "name": "WordCard",
      "reusable": true,
      "props": ["word", "phonetic", "translation", "onPlayAudio"]
    }
  ]
}

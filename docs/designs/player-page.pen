{
  "version": "2.11",
  "name": "VidLang Player Page - 视频播放页设计",
  "description": "视频播放器界面，包含控制条、字幕显示、工具栏等",
  "basedOn": "Pencil UI Design Skill v2.0",
  "created": "2026-06-27",
  
  "children": [
    {
      "id": "playerPage",
      "type": "frame",
      "name": "PlayerPage - 视频播放页",
      "width": 390,
      "height": 844,
      "fill": "#000000", // 播放器始终深色背景
      "cornerRadius": 0,
      "layout": "vertical",
      "children": [
        // 视频区域
        {
          "id": "videoArea",
          "type": "frame",
          "name": "视频播放区域",
          "width": "fill_container",
          "height": 220, // 16:9 比例（约）
          "fill": "#1A1A1A", // playerOverlayGradient
          "layout": "vertical",
          "alignItems": "center",
          "justifyContent": "center",
          "children": [
            {
              "id": "playButtonLarge",
              "type": "frame",
              "name": "大播放按钮",
              "width": 64,
              "height": 64,
              "fill": "#FFFFFF1A", // 半透明白色
              "cornerRadius": 9999, // 圆形
              "layout": "vertical",
              "alignItems": "center",
              "justifyContent": "center",
              "children": [
                {
                  "id": "playIconLarge",
                  "type": "icon_font",
                  "iconFontFamily": "Material Symbols Rounded",
                  "iconFontName": "play_arrow",
                  "fontSize": 32,
                  "width": 32,
                  "height": 32,
                  "fill": "#FFFFFF"
                }
              ]
            }
          ]
        },
        
        // 字幕显示区域
        {
          "id": "subtitleArea",
          "type": "frame",
          "name": "字幕显示区域",
          "width": "fill_container",
          "padding": [16, 16, 16, 16],
          "layout": "vertical",
          "alignItems": "center",
          "children": [
            {
              "id": "subtitleContainer",
              "type": "frame",
              "name": "字幕容器",
              "width": "fill_container",
              "padding": [16, 16, 16, 16],
              "fill": "#00000099", // 半透明黑色背景 (playerSubtitleBg)
              "cornerRadius": 12, // radius-lg
              "layout": "vertical",
              "alignItems": "center",
              "children": [
                {
                  "id": "subtitleText",
                  "type": "text",
                  "name": "英文字幕",
                  "content": "Hello, how are you today?",
                  "fontSize": 18,
                  "fontWeight": 400,
                  "fill": "#FFFFFF",
                  "textAlign": "center",
                  "lineHeight": 1.5,
                  "textGrowth": "fixed-width"
                },
                {
                  "id": "subtitleTranslation",
                  "type": "text",
                  "name": "中文翻译",
                  "content": "你好，今天怎么样？",
                  "fontSize": 14,
                  "fontWeight": 400,
                  "fill": "#FFE082", // playerSubtitleTranslate
                  "textAlign": "center",
                  "lineHeight": 1.5,
                  "textGrowth": "auto"
                }
              ]
            }
          ]
        },
        
        // 控制条区域
        {
          "id": "controlBar",
          "type": "frame",
          "name": "控制条",
          "width": "fill_container",
          "padding": [12, 16, 24, 16], // 底部额外 padding 用于安全区域
          "layout": "vertical",
          "gap": 12,
          "children": [
            // 进度条
            {
              "id": "progressBar",
              "type": "frame",
              "name": "进度条",
              "width": "fill_container",
              "height": 4,
              "fill": "#333333", // playerProgressInactive
              "cornerRadius": 9999,
              "clip": true,
              "children": [
                {
                  "id": "progressBuffered",
                  "type": "frame",
                  "name": "缓冲进度",
                  "width": "fill_container",
                  "height": "fill_container",
                  "fill": "#FFFFFF33" // playerProgressBuffered
                },
                {
                  "id": "progressPlayed",
                  "type": "frame",
                  "name": "已播放进度",
                  "width": 180, // 示例：45% 进度
                  "height": "fill_container",
                  "fill": "#4ADE80", // primaryBrand (使用品牌色作为进度色)
                  "cornerRadius": 9999
                },
                {
                  "id": "progressThumb",
                  "type": "ellipse",
                  "name": "进度滑块",
                  "x": 176,
                  "y": -4,
                  "width": 12,
                  "height": 12,
                  "fill": "#4ADE80"
                }
              ]
            },
            
            // 时间显示
            {
              "id": "timeDisplay",
              "type": "frame",
              "name": "时间显示",
              "width": "fill_container",
              "layout": "horizontal",
              "justifyContent": "space_between",
              "children": [
                {
                  "id": "currentTime",
                  "type": "text",
                  "name": "当前时间",
                  "content": "12:34",
                  "fontSize": 12,
                  "fontWeight": 400,
                  "fill": "#CCCCCC",
                  "fontFamily": "SF Mono", // 等宽字体
                  "textGrowth": "auto"
                },
                {
                  "id": "totalTime",
                  "type": "text",
                  "name": "总时长",
                  "content": "28:15",
                  "fontSize": 12,
                  "fontWeight": 400,
                  "fill": "#CCCCCC",
                  "fontFamily": "SF Mono",
                  "textGrowth": "auto"
                }
              ]
            },
            
            // 控制按钮行
            {
              "id": "controlButtons",
              "type": "frame",
              "name": "控制按钮行",
              "width": "fill_container",
              "layout": "horizontal",
              "alignItems": "center",
              "justifyContent": "space_evenly",
              "children": [
                // 倍速按钮
                {
                  "id": "speedBtn",
                  "type": "frame",
                  "name": "倍速按钮",
                  "width": 48,
                  "height": 40,
                  "layout": "vertical",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    {
                      "id": "speedLabel",
                      "type": "text",
                      "name": "1.0x",
                      "content": "1.0x",
                      "fontSize": 12,
                      "fontWeight": 500,
                      "fill": "#4284FC", // playerTimerChipColor / primary
                      "textGrowth": "auto"
                    }
                  ]
                },
                
                // 上一句按钮
                {
                  "id": "prevBtn",
                  "type": "icon_font",
                  "iconFontFamily": "Material Symbols Rounded",
                  "iconFontName": "skip_previous",
                  "fontSize": 32,
                  "width": 32,
                  "height": 32,
                  "fill": "#FFFFFF"
                },
                
                // 播放/暂停按钮（主按钮）
                {
                  "id": "playPauseBtn",
                  "type": "frame",
                  "name": "播放/暂停按钮",
                  "width": 56,
                  "height": 56,
                  "fill": "#4ADE80", // primaryBrand
                  "cornerRadius": 9999,
                  "layout": "vertical",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "color": "#4ADE804D",
                    "blur": 8,
                    "offsetY": 2
                  },
                  "children": [
                    {
                      "id": "playPauseIcon",
                      "type": "icon_font",
                      "iconFontFamily": "Material Symbols Rounded",
                      "iconFontName": "pause",
                      "fontSize": 28,
                      "width": 28,
                      "height": 28,
                      "fill": "#18181B" // textPrimary (深色图标在亮色背景上)
                    }
                  ]
                },
                
                // 下一句按钮
                {
                  "id": "nextBtn",
                  "type": "icon_font",
                  "iconFontFamily": "Material Symbols Rounded",
                  "iconFontName": "skip_next",
                  "fontSize": 32,
                  "width": 32,
                  "height": 32,
                  "fill": "#FFFFFF"
                },
                
                // 列表按钮
                {
                  "id": "listBtn",
                  "type": "icon_font",
                  "iconFontFamily": "Material Symbols Rounded",
                  "iconFontName": "playlist_play",
                  "fontSize": 28,
                  "width": 28,
                  "height": 28,
                  "fill": "#FFFFFF99" // 半透明
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  
  "designNotes": [
    "播放器始终使用深色背景 (#000000)",
    "主操作按钮（播放/暂停）使用品牌色 #4ADE80",
    "进度条也使用品牌色，保持视觉一致性",
    "字幕区域使用半透明黑色背景 + 圆角",
    "翻译文字使用金黄色 (#FFE082) 区分",
    "控制按钮大小层级：主按钮 56px > 操作按钮 32px > 辅助按钮 28px",
    "时间显示使用等宽字体 (SF Mono)",
    "所有图标使用 Material Symbols Rounded",
    "支持横屏模式（宽度自适应）"
  ],
  
  "interactions": [
    {"element": "playPauseBtn", "action": "toggle", "states": ["playing", "paused"]},
    {"element": "progressBar", "action": "seek", "type": "scrub"},
    {"element": "speedBtn", "action": "show_menu", "options": ["0.5x", "0.75x", "1.0x", "1.25x", "1.5x", "2.0x"]},
    {"element": "subtitleText", "action": "word_tap", "effect": "show_word_popup"}
  ]
}
